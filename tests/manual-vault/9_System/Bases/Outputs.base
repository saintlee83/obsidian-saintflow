filters:
  and:
    - 'file.inFolder("4_Transform/Outputs")'
formulas:
  stage: 'if(status == "draft", 1, if(status == "in review", 2, if(status == "done", 3, if(status == "shipped", 4, 0))))'
  unlinked: '(status == "done" || status == "shipped") && archived != true && (!uses || uses.length == 0)'
properties:
  file.name:
    displayName: 이름
  kind:
    displayName: 종류
  status:
    displayName: 상태
  project:
    displayName: Project
  uses:
    displayName: 사용한 지식·자료
  link:
    displayName: 링크
  formula.unlinked:
    displayName: 지식 미연결
views:
  - type: table
    name: 전체
    filters:
      and:
        - 'archived != true'
    order:
      - file.name
      - kind
      - status
      - project
      - uses
      - link
    sort:
      - property: formula.stage
        direction: ASC
  - type: table
    name: 점검
    filters:
      and:
        - 'archived != true'
        - or:
            - 'status == "done"'
            - 'status == "shipped"'
    order:
      - file.name
      - project
      - uses
      - formula.unlinked
  - type: table
    name: 연결됨
    filters:
      and:
        - 'file.hasLink(this.file)'
        - 'archived != true'
    order:
      - file.name
      - kind
      - status
  - type: table
    name: 보관
    filters:
      and:
        - 'archived == true'
    order:
      - file.name
      - kind
