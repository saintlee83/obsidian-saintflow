{
  "name": "saintflow",
  "version": "0.2.0",
  "description": "SaintFlow Obsidian plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --import tsx --test tests/checks.test.ts tests/naming.test.ts tests/dates.test.ts tests/sections.test.ts tests/schema.test.ts tests/lint.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
